// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url = env("DATABASE_URL")
}

model Organization {
  id    Int    @id @default(autoincrement())
  name  String
  email String? @unique

  users           User[]
  departments     Department[]
  categories      Category[]
  items           Item[]
  instances       Instance[]
  locations       Location[]
  rentals         Rental[]
  reservations    Reservation[]
  maintenanceLogs MaintenanceLog[]
  notifications   Notification[]
  activityLogs    ActivityLog[]
  instanceLogs    InstanceLog[]
  borrowers       Borrower[]
  loans           Loan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id             Int          @id @default(autoincrement())
  name           String
  email          String       @unique
  password       String
  role           Role         @default(USER)
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  departmentId   Int?
  department     Department?  @relation(fields: [departmentId], references: [id])
  rentals        Rental[]
  reservations   Reservation[]
  notifications  Notification[]
  activityLogs   ActivityLog[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Department {
  id             Int          @id @default(autoincrement())
  name           String
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])

  users          User[]

  createdAt      DateTime     @default(now())
}

model Category {
  id             Int          @id @default(autoincrement())
  name           String
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])

  items          Item[]
}

model Item {
  id             Int          @id @default(autoincrement())
  name           String
  categoryId     Int
  category       Category     @relation(fields: [categoryId], references: [id])
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  description    String?

  instances      Instance[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Instance {
  id             Int          @id @default(autoincrement())
  itemId         Int
  item           Item         @relation(fields: [itemId], references: [id])
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])

  instanceName   String?
  serialNumber   String?
  status         InstanceStatus @default(AVAILABLE)
  locationId     Int?
  location       Location?     @relation(fields: [locationId], references: [id])
  description    String?

  rentals        Rental[]
  reservations   Reservation[]
  maintenanceLogs MaintenanceLog[]
  logs           InstanceLog[]
  loans          Loan[]

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Location {
  id             Int          @id @default(autoincrement())
  name           String
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])

  instances      Instance[]

  createdAt      DateTime     @default(now())
}

model Rental {
  id             Int      @id @default(autoincrement())
  instanceId     Int
  userId         Int
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])

  instance       Instance @relation(fields: [instanceId], references: [id])
  user           User     @relation(fields: [userId], references: [id])

  rentedAt       DateTime @default(now())
  dueDate        DateTime
  returnedAt     DateTime?

  status         RentalStatus @default(RENTED)

  createdAt      DateTime @default(now())
}

model Reservation {
  id             Int      @id @default(autoincrement())
  instanceId     Int
  userId         Int
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])

  instance       Instance @relation(fields: [instanceId], references: [id])
  user           User     @relation(fields: [userId], references: [id])

  startDate      DateTime
  endDate        DateTime

  status         ReservationStatus @default(ACTIVE)
}

model MaintenanceLog {
  id             Int      @id @default(autoincrement())
  instanceId     Int
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])

  instance       Instance @relation(fields: [instanceId], references: [id])

  type           MaintenanceType
  description    String?
  performedAt    DateTime @default(now())
}

model Notification {
  id             Int      @id @default(autoincrement())
  userId         Int
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])

  user           User     @relation(fields: [userId], references: [id])

  type           NotificationType
  message        String
  isRead         Boolean  @default(false)

  createdAt      DateTime @default(now())
}

model ActivityLog {
  id             Int      @id @default(autoincrement())
  userId         Int
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])

  user           User     @relation(fields: [userId], references: [id])

  action         String
  targetType     String
  targetId       Int?

  createdAt      DateTime @default(now())
}

model InstanceLog {
  id             Int      @id @default(autoincrement())
  instanceId     Int
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])

  instance       Instance @relation(fields: [instanceId], references: [id])

  status         InstanceStatus
  changedAt      DateTime @default(now())
}



enum Role {
  ADMIN
  USER
  GEST
}

enum InstanceStatus {
  AVAILABLE
  RENTED
  BROKEN
}

enum RentalStatus {
  RENTED
  RETURNED
  OVERDUE
}

enum ReservationStatus {
  ACTIVE
  CANCELLED
  COMPLETED
}

enum MaintenanceType {
  REPAIR
  INSPECTION
}

enum NotificationType {
  DUE_SOON
  OVERDUE
}

enum LoanStatus {
  ACTIVE
  RETURNED
  OVERDUE
}

model Borrower {
  id             Int          @id @default(autoincrement())
  name           String
  type           BorrowerType
  departmentId   Int?
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  
  contactInfo    String?
  notes          String?
  
  loans          Loan[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

enum BorrowerType {
  INTERNAL_DEPARTMENT
  EXTERNAL_ORGANIZATION
  INDIVIDUAL
}

model Loan {
  id             Int         @id @default(autoincrement())
  instanceId     Int
  borrowerId     Int
  organizationId Int
  
  instance       Instance    @relation(fields: [instanceId], references: [id])
  borrower       Borrower    @relation(fields: [borrowerId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
  
  loanDate       DateTime    @default(now())
  dueDate        DateTime
  returnDate     DateTime?
  
  status         LoanStatus  @default(ACTIVE)
  notes          String?

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}
